# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL / PostGIS -------------------------------------------------------
POSTGRES_USER=sagar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sagar_drishti
POSTGRES_PORT=5432
# Host-side URL (make backend / tests). Inside docker compose the host is "db".
DATABASE_URL=postgresql+psycopg://sagar:change-me@localhost:5432/sagar_drishti
# Separate database used by integration tests (created automatically if absent).
TEST_DATABASE_URL=postgresql+psycopg://sagar:change-me@localhost:5432/sagar_drishti_test

# --- Redis / Celery -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# --- USNIC source ---------------------------------------------------------------
USNIC_CSV_URL=https://usicecenter.gov/File/DownloadCurrent?pId=134
USNIC_PRODUCT_PAGE_URL=https://usicecenter.gov/Products/AntarcIcebergs
INGESTION_INTERVAL_HOURS=72
STALE_AFTER_DAYS=10

# --- Basemap imagery (NASA GIBS Blue Marble, EPSG:3031), proxied + cached ------
BASEMAP_ENABLED=true
# BASEMAP_CACHE_DIR=/srv/data/processed/basemap

# --- Environmental features (environmental model versions only) --------------
# The base model and v1 never use these. Without credentials the pipeline stays
# inactive and says so (no values are ever substituted).
ENV_ENABLED=true
ENV_WIND_PROVIDER=copernicus_marine                # operational: WIND_GLO_PHY_L4_NRT_012_004
ENV_CURRENT_PROVIDER=copernicus_marine             # operational: GLOBAL_ANALYSISFORECAST_PHY_001_024 (uo/vo, 0.494 m)
ENV_SEA_ICE_PROVIDER=copernicus_marine             # operational: GLOBAL_ANALYSISFORECAST_PHY_001_024 (siconc)
ENV_HISTORICAL_WIND_PROVIDER=era5                  # training: ERA5 u10/v10 (or copernicus_marine = WIND_GLO_PHY_L4_MY_012_006)
ENV_HISTORICAL_CURRENT_PROVIDER=copernicus_marine  # training: GLOBAL_MULTIYEAR_PHY_001_030 (GLORYS, from 1993)
ENV_HISTORICAL_SEA_ICE_PROVIDER=copernicus_marine  # training: GLOBAL_MULTIYEAR_PHY_001_030 (or era5)
ENV_CANDIDATE_SCHEMAS=trajectory_v1,traj_wind_v1,traj_current_v1,traj_wind_current_v1,traj_wind_current_ice_v1
ENV_MAX_STALENESS_DAYS=3
ENV_TRAINING_MAX_HISTORICAL_SAMPLES=30000
ENV_TRAINING_MAX_TEST_SAMPLES=8000
ENV_ARCHIVE_FORECAST_FIELDS=true
# ENV_FALLBACK_MODEL_VERSION=v1                    # default: nearest trajectory-only ancestor of the champion
# ENV_CACHE_DIR=/srv/data/processed/environment
# Credentials — never commit real values
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
CDSAPI_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api

# --- Paths (container defaults shown; host defaults resolve to the repo) --------
# MODELS_DIR=/srv/models
# RAW_DATA_DIR=/srv/data/raw
# BOOTSTRAP_DATASET_PATH=/srv/data/bootstrap/consolidated_database_v8.0.zip

# --- Sequence adapter -----------------------------------------------------------
ADAPTER_STRATEGY=bootstrap_v1
ADAPTER_MAX_GAP_DAYS=730

# --- Retraining / promotion policy ----------------------------------------------
RETRAIN_CHECK_INTERVAL_HOURS=168
RETRAIN_MIN_NEW_EVALUATIONS=50
RETRAIN_MIN_NEW_ICEBERGS=5
RETRAIN_MIN_DAYS_SINCE_LAST_TRAINING=7
RETRAIN_STRATEGY=fine_tune
RETRAIN_EPOCHS=20
PROMOTION_PRIMARY_HORIZON=7
PROMOTION_MIN_RELATIVE_IMPROVEMENT=0.02
PROMOTION_MAX_SHORT_HORIZON_REGRESSION=0.05
PROMOTION_MIN_EVALUATION_SAMPLES=30
